# =============================================================================
# Python AI 服务环境变量示例
# 使用方式：复制为 .env 后按需修改（.env 不要提交到版本库）
# 所有配置一律通过环境变量注入，代码中不硬编码任何 API Key。
# =============================================================================

# ---------- 阿里云 DashScope（embedding / rerank）----------
# 【必填】DashScope API Key，用于 text-embedding-v2 向量化与 gte-rerank 重排
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DashScope 服务地址（一般无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# embedding 模型名，可选 v1/v2/v3/v4
EMBEDDING_MODEL=text-embedding-v2
# embedding 维度，必须与数据库中 vector(N) 的 N 一致（text-embedding-v2 为 1536）
EMBEDDING_DIM=1536

# ---------- DeepSeek（对话大模型，走 OpenAI 兼容协议）----------
# 【必填】DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek 服务地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型名，如 deepseek-chat / deepseek-reasoner
CHAT_MODEL=deepseek-chat
# 采样温度
CHAT_TEMPERATURE=0.7

# ---------- PostgreSQL（pgvector）----------
# 数据库连接串，默认本地 postgres 库；schema 为 cv（表 cv.resume_knowledge_base）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# 连接池大小
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ---------- RAG 检索 ----------
# 是否启用 DashScope gte-rerank 重排（关闭时按向量相似度排序）
RAG_RERANK_ENABLED=true
# 重排模型名
RAG_RERANK_MODEL=gte-rerank
# 相似度阈值：低于该分数的片段被丢弃（重排后分数或向量归一化分数）
RAG_SIMILARITY_THRESHOLD=0.35
# 最终返回的最大片段数
RAG_MAX_TOP_K=8
# 召回放大系数：先按 topK * expandFactor 扩大召回，再重排截断
RAG_EXPAND_FACTOR=2

# ---------- SearXNG 联网搜索（可选）----------
# SearXNG 搜索接口地址，服务不可用时自动兜底返回空结果
SEARXNG_URL=http://localhost:8888/search

# ---------- 服务与 HTTP ----------
# Python AI 服务监听端口
SERVER_PORT=8000
# 外部 HTTP 调用（DashScope / SearXNG）超时时间（秒）
HTTP_TIMEOUT=30

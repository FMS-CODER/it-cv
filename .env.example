# ============================================
# 使用方式：cp .env.example .env 后按需修改
# 变量名需与 docker-compose.yml 中的 ${} 引用完全一致
# ============================================

# ============================================
# 【必填】API Key（不填容器内读不到，启动会报 API key must be set）
# ============================================
SPRING_AI_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPRING_AI_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 【选填】PostgreSQL（不配则用默认值）
# 注意：若数据卷 pgdata 已初始化过，改密码不会同步到库内，
#       需与初始化时保持一致，否则后端连不上数据库
# ============================================
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================
# 【选填】对外端口与日志目录（有默认值，可不配）
# ============================================
HTTP_PUBLISH_PORT=80
BACKEND_PORT=8080
# 后端日志落地到宿主机的目录（默认 ./data/logs）
# BACKEND_LOG_DIR=/data/logs

# ============================================
# 【选填】SearXNG 容器内互访地址（一般保持默认）
# ============================================
SEARXNG_URL=http://searxng:8080/search
